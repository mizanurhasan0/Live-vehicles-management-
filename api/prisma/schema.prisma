generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GUARDIAN
  DRIVER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  ON_TRIP
  MAINTENANCE
}

enum TripStatus {
  STARTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum NotificationType {
  TRIP_STARTED
  VEHICLE_NEAR_PICKUP
  TRIP_COMPLETED
  PAYMENT_REMINDER
  PAYMENT_RECEIVED
}

model Madrasa {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  vehicles      Vehicle[]
  drivers       Driver[]
  guardians     Guardian[]
  students      Student[]
  routes        Route[]
  trips         Trip[]
  payments      Payment[]
  notifications Notification[]
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String   @unique
  password     String
  name         String
  photoUrl     String?
  role         Role
  madrasaId    String
  refreshToken String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  madrasa       Madrasa        @relation(fields: [madrasaId], references: [id])
  driver        Driver?
  guardian      Guardian?
  notifications Notification[]

  @@index([madrasaId])
}

model Driver {
  id        String   @id @default(cuid())
  userId    String   @unique
  madrasaId String
  licenseNo String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  madrasa Madrasa   @relation(fields: [madrasaId], references: [id])
  vehicle Vehicle?
  trips   Trip[]

  @@index([madrasaId])
}

model Guardian {
  id        String   @id @default(cuid())
  userId    String   @unique
  madrasaId String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  madrasa  Madrasa   @relation(fields: [madrasaId], references: [id])
  students Student[]
  payments Payment[]

  @@index([madrasaId])
}

model Vehicle {
  id        String        @id @default(cuid())
  madrasaId String
  number    String
  capacity  Int
  status    VehicleStatus @default(ACTIVE)
  driverId   String?       @unique
  routeId    String?
  deviceImei String?       @unique
  createdAt  DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  madrasa  Madrasa   @relation(fields: [madrasaId], references: [id])
  driver   Driver?   @relation(fields: [driverId], references: [id])
  route    Route?    @relation(fields: [routeId], references: [id])
  students Student[]
  trips    Trip[]

  @@unique([madrasaId, number])
  @@index([madrasaId])
}

model Student {
  id          String   @id @default(cuid())
  madrasaId   String
  guardianId  String
  vehicleId   String?
  name        String
  class       String?
  pickupPoint String
  dropPoint   String
  pickupLat   Float?
  pickupLng   Float?
  dropLat     Float?
  dropLng     Float?
  monthlyFee  Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  madrasa  Madrasa   @relation(fields: [madrasaId], references: [id])
  guardian Guardian  @relation(fields: [guardianId], references: [id])
  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id])
  payments Payment[]

  @@index([madrasaId])
  @@index([guardianId])
  @@index([vehicleId])
}

model Route {
  id        String   @id @default(cuid())
  madrasaId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  madrasa  Madrasa     @relation(fields: [madrasaId], references: [id])
  stops    RouteStop[]
  vehicles Vehicle[]

  @@index([madrasaId])
}

model RouteStop {
  id      String @id @default(cuid())
  routeId String
  name    String
  lat     Float
  lng     Float
  order   Int

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
}

model Trip {
  id        String     @id @default(cuid())
  madrasaId String
  vehicleId String
  driverId  String
  status    TripStatus @default(STARTED)
  startedAt DateTime   @default(now())
  endedAt   DateTime?

  madrasa      Madrasa       @relation(fields: [madrasaId], references: [id])
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id])
  driver       Driver        @relation(fields: [driverId], references: [id])
  locationLogs LocationLog[]

  @@index([madrasaId])
  @@index([vehicleId])
  @@index([driverId])
}

model LocationLog {
  id        String   @id @default(cuid())
  tripId    String
  lat       Float
  lng       Float
  speed     Float?
  heading   Float?
  source    String   @default("PHONE_GPS")
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model Payment {
  id             String        @id @default(cuid())
  madrasaId      String
  guardianId     String
  studentId      String
  amount         Decimal       @db.Decimal(10, 2)
  month          String
  status         PaymentStatus @default(PENDING)
  bkashTrxId     String?
  bkashPaymentId String?
  invoiceNo      String        @unique @default(cuid())
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  madrasa  Madrasa  @relation(fields: [madrasaId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id])

  @@index([madrasaId])
  @@index([guardianId])
  @@index([studentId])
  @@index([month])
}

model Notification {
  id        String           @id @default(cuid())
  madrasaId String
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  madrasa Madrasa @relation(fields: [madrasaId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([madrasaId])
}
