# Copy to web/.env.local and adjust for your setup.

# --- nginx / LAN (phone on same Wi‑Fi) ---
# Mac IP: ipconfig getifaddr en0
# ALLOWED_DEV_ORIGINS=192.168.1.105
# NEXT_PUBLIC_APP_URL=http://192.168.1.105

# When using nginx/LAN, API + WS use same host (/backend-api proxy).
# Leave NEXT_PUBLIC_API_URL unset unless API is on a different domain.
